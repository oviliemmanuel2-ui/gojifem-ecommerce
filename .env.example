# ==========================================
# GOJIFEM ENVIRONMENT CONFIGURATION
# ==========================================

# Application
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL="postgresql://gojifem:gojifem_secret@localhost:5432/gojifem_db?schema=public"

# Cache & Queues (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_key_at_least_32_chars_long
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Primary Payment Provider (Paystack)
PAYSTACK_SECRET_KEY=sk_test_placeholder
PAYSTACK_PUBLIC_KEY=pk_test_placeholder
PAYSTACK_WEBHOOK_SECRET=whsec_placeholder

# Secondary Payment Provider (Flutterwave)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-placeholder
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-placeholder
FLUTTERWAVE_WEBHOOK_HASH=flw_webhook_hash_placeholder

# Storage (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_ENDPOINT=
STORAGE_BUCKET=gojifem-assets
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto
