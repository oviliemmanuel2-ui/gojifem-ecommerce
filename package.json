{
  "name": "gojifem-ecommerce",
  "version": "0.1.0",
  "private": true,
  "description": "GOJIFEM - Nigeria & Global Multi-Vendor E-Commerce Marketplace",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "prisma generate --schema=packages/database/prisma/schema.prisma",
    "build": "npm run --workspaces --if-present build",
    "lint": "npm run --workspaces --if-present lint",
    "test": "npm run --workspaces --if-present test",
    "db:generate": "npm run --workspace=@gojifem/database generate",
    "db:migrate": "npm run --workspace=@gojifem/database migrate:dev",
    "db:migrate:deploy": "npm run --workspace=@gojifem/database migrate:deploy",
    "db:migrate:status": "prisma migrate status --schema=packages/database/prisma/schema.prisma",
    "db:verify": "node scripts/verify-database.mjs",
    "db:seed": "npm run --workspace=@gojifem/database seed",
    "dev:api": "npm run --workspace=@gojifem/api start:dev",
    "dev:web": "npm run --workspace=@gojifem/web dev",
    "dev:mobile": "npm run --workspace=@gojifem/mobile start",
    "docker:up": "docker compose -f docker-compose.prod.yml up -d postgres redis",
    "docker:down": "docker compose -f docker-compose.prod.yml down"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
