# ==============================================================
# GOJIFEM WEB STOREFRONT & SERVERLESS API - VERCEL ENV VARS
# ==============================================================
# Optional override if hosting apps/api separately (leave UNSET on
# Vercel to automatically use same-origin /api/v1 serverless routes)
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

# --------------------------------------------------------------
# DATABASE (PostgreSQL via Neon / Supabase / Vercel Postgres)
# --------------------------------------------------------------
# Required in Vercel Environment Variables (Preview + Production).
# Do NOT use localhost or 127.0.0.1 in deployed environments.
# If your provider uses PgBouncer connection pooling (e.g. Neon -pooler
# or Supabase port 6543), set DATABASE_URL to the pooled URL with
# ?sslmode=require and optionally set DIRECT_URL to the non-pooled URL
# for `prisma migrate deploy` (PostgreSQL SSL direct port 5432).
DATABASE_URL=
# DIRECT_URL=

# --------------------------------------------------------------
# JWT SESSION SECRETS (Generate long random 32+ char strings)
# --------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=

# --------------------------------------------------------------
# OFFICIAL GOOGLE OAUTH 2.0
# --------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; defaults automatically to current origin:
# https://<your-domain>/auth/callback/google
GOOGLE_REDIRECT_URI=

# --------------------------------------------------------------
# OFFICIAL SIGN IN WITH APPLE
# --------------------------------------------------------------
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Optional override; defaults automatically to current origin:
# https://<your-domain>/api/v1/auth/apple/callback
APPLE_REDIRECT_URI=

# --------------------------------------------------------------
# PAYMENT GATEWAYS & SUPPORT CONTACT
# --------------------------------------------------------------
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
CONTACT_DESTINATION_EMAIL=support@gojifem.com

# --------------------------------------------------------------
# SANITY CMS CONFIGURATION
# --------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=
