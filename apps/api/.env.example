# ==============================================================
# GOJIFEM MULTI-VENDOR MARKETPLACE - BACKEND ENVIRONMENT CONFIG
# ==============================================================

# Application Port & Web URLs
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# PostgreSQL Database Connection
DATABASE_URL=postgresql://gojifem:gojifem_dev_pwd@localhost:5432/gojifem_marketplace?schema=public

# Redis Cache & Asynchronous BullMQ Outbox
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication Secrets
JWT_ACCESS_SECRET=gojifem_super_secure_access_secret_2026_dev
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=gojifem_super_secure_refresh_secret_2026_dev
JWT_REFRESH_TTL=30d

# --------------------------------------------------------------
# 1. PAYSTACK PAYMENT GATEWAY
# (Card, Bank Transfer, USSD, Apple Pay & 3DS International Cards)
# --------------------------------------------------------------
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=pstk_whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------------------
# 2. FLUTTERWAVE PAYMENT GATEWAY
# (Multi-Currency NGN, USD, GBP, EUR & Global Cards)
# --------------------------------------------------------------
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TESTxxxxxxxx
FLUTTERWAVE_WEBHOOK_HASH=gojifem_flw_secure_webhook_hash_2026

# --------------------------------------------------------------
# 3. GIG LOGISTICS (GIGL) COURIER
# (Nigeria Nationwide Doorstep Delivery Across 36 States + FCT)
# --------------------------------------------------------------
GIGL_API_KEY=gigl_live_or_test_key_placeholder
GIGL_CLIENT_ID=gigl_merchant_client_id_placeholder
GIGL_ENDPOINT=https://api.gigl.ng/v1

# --------------------------------------------------------------
# 4. KWIK DELIVERY COURIER
# (Instant On-Demand Urban Bike/Van Dispatch in Lagos, Abuja, Ibadan)
# --------------------------------------------------------------
KWIK_API_KEY=kwik_token_placeholder
KWIK_VENDOR_ID=kwik_merchant_vendor_id_placeholder
KWIK_ENDPOINT=https://api.kwik.delivery/v2

# --------------------------------------------------------------
# 5. DHL EXPRESS NIGERIA & INTERNATIONAL
# (Domestic Priority Express & Global Exports to UK, US, CA, GH)
# --------------------------------------------------------------
DHL_API_KEY=dhl_express_api_key_placeholder
DHL_API_SECRET=dhl_express_secret_placeholder
DHL_ACCOUNT_NUMBER=123456789
DHL_ENDPOINT=https://express.api.dhl.com/mydhlapi/test
